# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# TikTok API (tùy chọn — để trống nếu upload thủ công)
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Cài đặt bot
# ID Telegram của admin (bot chỉ phục vụ các ID này, để trống = ai cũng dùng được)
ALLOWED_USER_IDS=

# Voice mặc định cho TTS
DEFAULT_VOICE=vi-VN-HoaiMyNeural

# Genre mặc định
DEFAULT_GENRE=romance
