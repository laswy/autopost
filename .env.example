# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Provider — chọn 1 trong 2 (Anthropic ưu tiên nếu có cả hai)
# Anthropic Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Groq — miễn phí tại console.groq.com
GROQ_API_KEY=
# Ghi đè provider tự động: anthropic | groq
AI_PROVIDER=

# TikTok API (tùy chọn — để trống nếu upload thủ công)
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Cài đặt bot
# ID Telegram của admin (bot chỉ phục vụ các ID này, để trống = ai cũng dùng được)
ALLOWED_USER_IDS=

# Voice mặc định cho TTS
DEFAULT_VOICE=vi-VN-HoaiMyNeural

# Genre mặc định
DEFAULT_GENRE=romance
