# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Provider — chọn 1 trong 3 (ưu tiên: anthropic > groq > claude-cli)
#
# Cách 1: Claude Code CLI / macOS app — KHÔNG cần key, dùng subscription Claude Pro
#   Cài: https://claude.ai/code  →  đăng nhập  →  bot tự nhận diện
#   AI_PROVIDER=claude-cli  (hoặc để trống, bot tự detect nếu `claude` có trong PATH)
#
# Cách 2: Groq — miễn phí, đăng ký tại console.groq.com
GROQ_API_KEY=
#
# Cách 3: Anthropic API — trả phí, console.anthropic.com
ANTHROPIC_API_KEY=
#
# Ghi đè tự động: anthropic | groq | claude-cli
AI_PROVIDER=

# OpenAI API — cho TTS gpt-4o-mini-tts (bài học tiếng Anh chất lượng cao)
# Đăng ký: platform.openai.com | ~$0.015/1000 ký tự
# Để trống → tự động fallback sang edge-tts (miễn phí)
OPENAI_API_KEY=
# Ghi đè TTS provider: openai | edge
TTS_PROVIDER=

# TikTok API (tùy chọn — để trống nếu upload thủ công)
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Cài đặt bot
# ID Telegram của admin (bot chỉ phục vụ các ID này, để trống = ai cũng dùng được)
ALLOWED_USER_IDS=

# Voice mặc định
# OpenAI voices: alloy | nova | echo | shimmer | onyx | fable
# edge-tts voices: vi-VN-HoaiMyNeural | vi-VN-NamMinhNeural | en-US-JennyNeural
DEFAULT_VOICE=shimmer

# Genre mặc định
DEFAULT_GENRE=romance
